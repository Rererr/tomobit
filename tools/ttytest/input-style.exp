#!/usr/bin/expect -f
# The input background on a real pty: the faint block behind the user's typed
# line (Claude Code style). lineedit.exp runs under NO_COLOR to keep its cursor
# maths clean, so this is where the colour layer is proven — the SGR opens
# after the prompt, wraps the text AND fills out to the right edge (ADR-0030),
# then closes before the cursor move.
# usage: expect tools/ttytest/input-style.exp <tomobit binary> [db]
set bin [lindex $argv 0]
if {$bin eq ""} { puts "usage: expect input-style.exp <tomobit binary> \[db\]"; exit 2 }
set db [lindex $argv 1]
if {$db eq ""} { set db "/tmp/tomobit-inputstyle.db" }
file delete $db $db-wal $db-shm $db.history

set timeout 8
log_user 0
set env(TOMOBIT_FACE) "0"

proc check {name pattern} {
    expect {
        -re $pattern { puts "PASS: $name" }
        timeout      { puts "FAIL: $name (timeout waiting for $pattern)"; exit 1 }
        eof          { puts "FAIL: $name (eof)"; exit 1 }
    }
}

spawn $bin chat --db $db --provider human
check "prompt" "話しかけて"

# The background opens (an SGR 48; sequence — 256-colour or truecolor) only
# after the prompt marker, wraps the text, then fills the row to the right edge
# with plain background spaces before resetting (0m) ahead of the cursor move.
# The run of spaces between "abc" and the reset is the edge-to-edge fill; the
# marker and the cursor sit outside the block.
send "abc"
sleep 0.3
check "background fills the row to the edge" "❯ \x1b\\\[48;\[0-9;\]+m\[^\x1b\]*abc \{10,\}\x1b\\\[0m"
send "\025"

# The marker itself carries no background: an empty line is just the prompt.
send "x"
sleep 0.3
check "prompt marker stays unstyled" "\x1b\\\[0J ❯ \x1b\\\[48;"
send "\025"

send "\004"
expect {
    eof     { puts "PASS: ctrl-d exit" }
    timeout { puts "FAIL: ctrl-d did not exit"; exit 1 }
}
puts "ALL PASS"
